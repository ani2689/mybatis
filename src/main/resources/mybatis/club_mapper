<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ani.mybatis.domain.mapper.ClubMapper">
    <select id="clubs" resultType="com.ani.mybatis.domain.model.Club">
        SELECT *
        FROM club
    </select>

    <select id="clubsByUser" resultType="com.ani.mybatis.domain.model.Club">
        SELECT *
        FROM club, member, user
        WHERE club.id = member.club_id AND user.id = member.user_id
    </select>

    <insert id="createClub">
        INSERT INTO club (name) VALUE #{name}
    </insert>

    <insert id="signupClub">
        INSERT INTO member (user_id, club_id) VALUE (#{user_id}, #{id})
    </insert>
</mapper>